# Copy this file to .env and fill in your real values. Never commit the real .env file.

# PostgreSQL connection (Render / Railway / PythonAnywhere / any self-hosted Postgres)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://naba_user:changeme@localhost:5432/naba_qc

# Used to sign session tokens / seed the very first Super Master Admin account
SUPER_ADMIN_SEED_USERNAME=super_admin
SUPER_ADMIN_SEED_PASSWORD=ChangeMe_On_First_Login!

# App branding defaults (each factory can override its own via White-Label settings)
APP_NAME=NABA Tech QC
CREDIT_LINE=Powered by NABA Tech By Kaleem Ullah Sharif
